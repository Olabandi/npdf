<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plattformunabhängige Logik ohne Avalonia: PDF-Schnittstelle (PDFium), Seitenoperationen,
       Übersetzungsschicht, Logging, Einstellungen. Die nativen PDFium-Bibliotheken binden die
       startbaren Projekte über die bblanchon-Pakete ein. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NeroPdf.Tests" />
  </ItemGroup>
</Project>
