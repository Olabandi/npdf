<Project Sdk="Microsoft.NET.Sdk">
  <!-- Startbares Programm für Windows mit den Windows-Implementierungen der Plattform-Schnittstellen.
       Wird als MSIX-Paket ausgeliefert (siehe packaging/windows), das auch den virtuellen Drucker anmeldet. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <AssemblyName>NeroPdf</AssemblyName>
    <!-- Precompiled code for a faster start. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <ApplicationIcon>..\NeroPdf.App\Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <!-- No debug symbols in the package: the native PDBs of SkiaSharp and HarfBuzz alone are about 100 MB. -->
  <Target Name="RemovePdbsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Only the Windows parts of Avalonia; Avalonia.Desktop would also bring Linux and macOS backends. -->
    <PackageReference Include="Avalonia.Win32" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.HarfBuzz" />
    <PackageReference Include="bblanchon.PDFium.Win32" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Config\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NeroPdf.App\NeroPdf.App.csproj" />
  </ItemGroup>
</Project>
